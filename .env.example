# 主问答（板块二才用；板块一可空）
CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_API_KEY=
CHAT_MODEL=qwen-plus

# 离线抽取（后置）
EXTRACT_BASE_URL=
EXTRACT_API_KEY=
EXTRACT_MODEL=qwen-plus

# 嵌入：dashscope | local(BGE-M3) | dummy(仅测)
DASHSCOPE_API_KEY=
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3

# 向量库：chroma（默认）| faiss
VECTOR_BACKEND=chroma
CHROMA_PERSIST_DIR=./data/indexes/chroma
CHROMA_COLLECTION_NAME=medical_kb
INGEST_DISEASE_LIMIT=400

# 已导入 OpenKG 的 Neo4j（只读）
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password
NEO4J_DATABASE=neo4j

# 会话（板块三：先 SQLite，Redis/MySQL 后接）
REDIS_URL=
MYSQL_DSN=
SQLITE_PATH=./data/sessions.db
HISTORY_MAX_TURNS=12

# HTTP：X-API-Key 或 Authorization: Bearer；逗号分隔多个 Key
API_KEYS=dev-key
RATE_LIMIT_PER_MINUTE=60
API_HOST=127.0.0.1
API_PORT=8000

LOG_LEVEL=INFO
# true 时每行一条 JSON（板块六）
LOG_JSON=false

# 可选 LangSmith：无 Key 保持关闭，不装 SDK 也不影响问答
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=smart-medical-consultation
